APP_NAME=Score API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/score_app_db

# Security & Authentication
# JWT_SECRET_KEY is required in production (minimum 32 characters)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# WhatsApp Cloud API Configuration
# Required for live automated sending of Order PDF via WhatsApp Cloud API
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional company admin/dispatch phone number (E.164 format, e.g. +919876543210)
WHATSAPP_ADMIN_RECIPIENT=
